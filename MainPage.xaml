<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OopMaui.MainPage"
             BackgroundColor="{DynamicResource PageBg}">

    <VerticalStackLayout Padding="20" Spacing="18">

        <!-- HEADER -->
        <Frame BackgroundColor="{DynamicResource CardBg}"
               CornerRadius="28"
               Padding="18"
               HasShadow="True">

            <VerticalStackLayout Spacing="6">

                <Label x:Name="ScoreLabel"
                       Text="Punktid: 0"
                       FontSize="30"
                       TextColor="{DynamicResource TextColor}"
                       HorizontalOptions="Center"
                       FontAttributes="Bold"/>

                <Label Text="Mälumäng"
                       FontSize="13"
                       TextColor="{DynamicResource TextColor}"
                       Opacity="0.7"
                       HorizontalOptions="Center"/>

            </VerticalStackLayout>
        </Frame>

        <!-- ICONS -->
        <Frame BackgroundColor="{DynamicResource CardBg}"
               CornerRadius="28"
               Padding="14">

            <VerticalStackLayout Spacing="10">

                <Label Text="🎮 Vali sümbolid"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextColor}"
                       HorizontalOptions="Center"/>

                <Label Text="Vali mängu sümbolite komplekt"
                       FontSize="12"
                       TextColor="{DynamicResource TextColor}"
                       Opacity="0.6"
                       HorizontalOptions="Center"/>

                <HorizontalStackLayout Spacing="12"
                                       HorizontalOptions="Center">

                    <Button Text="🐶"
                            Clicked="Animals"
                            FontSize="20"
                            BackgroundColor="{DynamicResource ButtonBg}"
                            TextColor="{DynamicResource TextColor}"
                            CornerRadius="18"
                            WidthRequest="65"
                            HeightRequest="55"/>

                    <Button Text="🍎"
                            Clicked="Fruits"
                            FontSize="20"
                            BackgroundColor="{DynamicResource ButtonBg}"
                            TextColor="{DynamicResource TextColor}"
                            CornerRadius="18"
                            WidthRequest="65"
                            HeightRequest="55"/>

                    <Button Text="😀"
                            Clicked="Faces"
                            FontSize="20"
                            BackgroundColor="{DynamicResource ButtonBg}"
                            TextColor="{DynamicResource TextColor}"
                            CornerRadius="18"
                            WidthRequest="65"
                            HeightRequest="55"/>

                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Frame>

        <!-- THEMES -->
        <Frame BackgroundColor="{DynamicResource CardBg}"
               CornerRadius="28"
               Padding="14">

            <VerticalStackLayout Spacing="10">

                <Label Text="🎨 Vali teema"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextColor}"
                       HorizontalOptions="Center"/>

                <Label Text="Muuda mängu värve ja stiili"
                       FontSize="12"
                       TextColor="{DynamicResource TextColor}"
                       Opacity="0.6"
                       HorizontalOptions="Center"/>

                <HorizontalStackLayout Spacing="12"
                                       HorizontalOptions="Center">

                    <Button Text="Hele"
                            Clicked="Light"
                            BackgroundColor="{DynamicResource ButtonBg}"
                            TextColor="{DynamicResource TextColor}"
                            CornerRadius="18"
                            WidthRequest="80"/>

                    <Button Text="Tume"
                            Clicked="Dark"
                            BackgroundColor="{DynamicResource ButtonBg}"
                            TextColor="{DynamicResource TextColor}"
                            CornerRadius="18"
                            WidthRequest="80"/>

                    <Button Text="Värviline"
                            Clicked="Color"
                            BackgroundColor="{DynamicResource ButtonBg}"
                            TextColor="{DynamicResource TextColor}"
                            CornerRadius="18"
                            WidthRequest="90"/>

                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Frame>

        <!-- GAME AREA -->
        <Frame BackgroundColor="{DynamicResource CardBg}"
               CornerRadius="32"
               Padding="18"
               HasShadow="True">

            <VerticalStackLayout Spacing="12">

                <Label Text="🧩 Mänguväli"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextColor}"
                       HorizontalOptions="Center"/>

                <Grid x:Name="GameGrid"
                      RowSpacing="12"
                      ColumnSpacing="12"
                      HorizontalOptions="Center"/>

            </VerticalStackLayout>

        </Frame>

    </VerticalStackLayout>
</ContentPage>