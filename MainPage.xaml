<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OopMaui.MainPage"
             BackgroundColor="{DynamicResource PageBg}">

    <VerticalStackLayout Padding="20" Spacing="18">

        <Frame BackgroundColor="{DynamicResource CardBg}"
               CornerRadius="28"
               Padding="18"
               HasShadow="True">

            <VerticalStackLayout Spacing="6">

                <Label x:Name="ScoreLabel"
                       Text="Score: 0"
                       FontSize="30"
                       TextColor="{DynamicResource TextColor}"
                       HorizontalOptions="Center"
                       FontAttributes="Bold"/>

                <Label Text="Memory Challenge"
                       FontSize="13"
                       TextColor="{DynamicResource TextColor}"
                       Opacity="0.7"
                       HorizontalOptions="Center"/>

            </VerticalStackLayout>
        </Frame>

        <Frame BackgroundColor="{DynamicResource CardBg}"
               CornerRadius="28"
               Padding="12">

            <HorizontalStackLayout Spacing="12"
                                   HorizontalOptions="Center">

                <Button Text="🐶"
                        Clicked="Animals"
                        FontSize="20"
                        BackgroundColor="{DynamicResource ButtonBg}"
                        TextColor="{DynamicResource TextColor}"
                        CornerRadius="18"
                        WidthRequest="65"
                        HeightRequest="55"/>

                <Button Text="🍎"
                        Clicked="Fruits"
                        FontSize="20"
                        BackgroundColor="{DynamicResource ButtonBg}"
                        TextColor="{DynamicResource TextColor}"
                        CornerRadius="18"
                        WidthRequest="65"
                        HeightRequest="55"/>

                <Button Text="😀"
                        Clicked="Faces"
                        FontSize="20"
                        BackgroundColor="{DynamicResource ButtonBg}"
                        TextColor="{DynamicResource TextColor}"
                        CornerRadius="18"
                        WidthRequest="65"
                        HeightRequest="55"/>

            </HorizontalStackLayout>
        </Frame>

        <Frame BackgroundColor="{DynamicResource CardBg}"
               CornerRadius="28"
               Padding="12">

            <HorizontalStackLayout Spacing="12"
                                   HorizontalOptions="Center">

                <Button Text="Light"
                        Clicked="Light"
                        BackgroundColor="{DynamicResource ButtonBg}"
                        TextColor="{DynamicResource TextColor}"
                        CornerRadius="18"
                        WidthRequest="80"/>

                <Button Text="Dark"
                        Clicked="Dark"
                        BackgroundColor="{DynamicResource ButtonBg}"
                        TextColor="{DynamicResource TextColor}"
                        CornerRadius="18"
                        WidthRequest="80"/>

                <Button Text="Color"
                        Clicked="Color"
                        BackgroundColor="{DynamicResource ButtonBg}"
                        TextColor="{DynamicResource TextColor}"
                        CornerRadius="18"
                        WidthRequest="80"/>

            </HorizontalStackLayout>
        </Frame>

        <!-- area -->
        <Frame BackgroundColor="{DynamicResource CardBg}"
               CornerRadius="32"
               Padding="18"
               HasShadow="True">

            <Grid x:Name="GameGrid"
                  RowSpacing="12"
                  ColumnSpacing="12"
                  HorizontalOptions="Center"/>

        </Frame>

    </VerticalStackLayout>
</ContentPage>